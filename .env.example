# Copy to .env.local and fill in the values.

# brapi.dev - B3 and US stock quotes (server-side only). Get a token at https://brapi.dev
BRAPI_TOKEN=

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server and scripts only: bypasses Row Level Security
SUPABASE_SECRET_KEY=

# Supabase > Connect > Session pooler (used by db:push, db:types and seed:demo)
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Shared demo account, created by `npm run seed:demo`
DEMO_EMAIL=demo@finora.app
DEMO_PASSWORD=

# Anthropic API key for the Assistente (AI summary and questions). Server-side only.
# Without it the app works and the Assistente page says it is unavailable.
ANTHROPIC_API_KEY=
